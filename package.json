{
    "type": "module",
    "name": "studioentretien",
    "version": "1.0.0",
    "engines": {
        "node": ">=22",
        "pnpm": ">=8"
    },
    "packageManager": "pnpm@9.15.9",
    "bin": {
        "blueprint": "./bin/blueprint"
    },
    "scripts": {
        "build": "pnpm --dir apps/web build",
        "build:web": "pnpm --dir apps/web build",
        "build:gateway": "pnpm --dir apps/realtime-gateway build",
        "build:all": "pnpm --dir apps/web build && pnpm --dir apps/realtime-gateway build",
        "build:graph": "pnpm exec tsc -b",
        "build:clean": "pnpm exec tsc -b --clean",
        "dev": "pnpm --dir apps/web dev",
        "dev:gateway": "pnpm --dir apps/realtime-gateway dev",
        "typecheck": "tsc --project apps/web/tsconfig.json --noEmit",
        "type-check": "pnpm exec tsc -b --pretty",
        "type-check:watch": "pnpm exec tsc -b -w",
        "type-check:tests:api": "pnpm exec tsc -p apps/api/tsconfig.test.json --noEmit",
        "type-check:tests:gateway": "pnpm exec tsc -p apps/realtime-gateway/tsconfig.test.json --noEmit",
        "validate": "pnpm run build && pnpm run type-check:tests:api && pnpm run type-check:tests:gateway",
        "test:run": "tsx scripts/runtime-harness.ts",
        "test:verify": "tsx scripts/verify.ts artifacts/trace.json",
        "test": "npm run test:run && npm run test:replay && npm run test:verify",
        "test:replay": "vitest run --globals tests/replay",
        "test:coverage": "vitest run --globals --coverage tests/replay",
        "test:cov": "vitest run --globals --coverage tests/replay",
        "test:e2e": "playwright test",
        "test:e2e:smoke": "playwright test --config=playwright.config.ts --project=chromium tests/e2e/01-homepage.spec.ts tests/e2e/02-auth.spec.ts tests/e2e/03-dashboard.spec.ts tests/e2e/04-api-health.spec.ts tests/e2e/05-ats-module.spec.ts tests/e2e/06-interview-module.spec.ts tests/e2e/07-stripe-webhook.spec.ts tests/e2e/08-pre-launch.spec.ts tests/e2e/09-mobile-recovery.spec.ts",
        "start": "pnpm --dir apps/web start",
        "lint": "eslint . --cache",
        "lint:fix": "eslint . --fix --cache",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "migration:up": "prisma migrate deploy",
        "migration:down": "prisma migrate resolve --applied",
        "db:studio": "prisma studio",
        "email:dev": "email dev --dir emails --port 3001",
        "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",
        "audit:sse": "tsx scripts/audit-sse.ts",
        "audit:env": "tsx scripts/audit-env.ts",
        "audit:auth": "tsx scripts/audit-auth.ts",
        "audit:bundle": "tsx scripts/audit-bundle.ts",
        "audit:edge": "tsx scripts/audit-edge.ts",
        "audit:db": "tsx scripts/audit-db.ts",
        "core:audit": "ts-node scripts/audit-behavioral-engine.ts",
        "stress": "tsx scripts/runtime-harness.ts stress",
        "golden-diff": "tsx scripts/golden-diff.ts",
        "cert": "node certification/certify.cjs",
        "cert:full": "node certification/archive.cjs clean && node certification/certify.cjs",
        "cert:coverage": "node certification/coverage.cjs",
        "cert:mutation": "node certification/mutation.cjs",
        "cert:regression": "node certification/regression.cjs",
        "cert:manifest": "node certification/manifest.cjs",
        "cert:verify": "node certification/verify.cjs",
        "cert:archive": "node certification/archive.cjs",
        "cert:replay": "node certification/replay.cjs",
        "cert:clean": "node certification/archive.cjs clean",
        "test:pbt": "vitest run tests/vm/properties",
        "test:pbt:full": "cross-env PBT_RUNS=10000 vitest run tests/vm/properties",
        "lab:pbt": "node laboratory/pbt-lab.cjs",
        "qualify:pbt": "pnpm test:pbt:full && pnpm lab:pbt",
        "typecheck:all": "tsc --project apps/web/tsconfig.json --noEmit",
        "typecheck:web": "tsc --project apps/web/tsconfig.json --noEmit",
        "typecheck:gateway": "tsc --project apps/realtime-gateway/tsconfig.json --noEmit",
        "typecheck:all:strict": "tsc --project apps/web/tsconfig.json --noEmit && tsc --project apps/realtime-gateway/tsconfig.json --noEmit"
    },
    "dependencies": {
        "@fingerprintjs/fingerprintjs": "^5.2.0",
        "@google/generative-ai": "^0.24.1",
        "@hookform/resolvers": "^4.1.3",
        "@nestjs/common": "^11.1.24",
        "@nestjs/platform-socket.io": "^11.1.24",
        "@nestjs/testing": "^11.1.24",
        "@nestjs/websockets": "^11.1.24",
        "@prisma/client": "6.1.0",
        "@radix-ui/react-slot": "^1.2.4",
        "@react-email/components": "^1.0.12",
        "@react-pdf/renderer": "^4.5.1",
        "@supabase/ssr": "^0.5.0",
        "@supabase/supabase-js": "^2.50.0",
        "@tailwindcss/postcss": "^4.3.0",
        "@types/jest": "^30.0.0",
        "@types/socket.io-client": "^1.4.36",
        "@upstash/ratelimit": "^2.0.8",
        "@upstash/redis": "^1.38.0",
        "ai": "^6.0.191",
        "ajv-formats": "^3.0.1",
        "autoprefixer": "^10.4.16",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "commander": "^12.0.0",
        "date-fns": "^4.1.0",
        "disposable-email-domains": "^1.0.62",
        "docx": "^9.7.0",
        "file-saver": "^2.0.5",
        "framer-motion": "^12.40.0",
        "hark": "^1.2.3",
        "helmet": "^8.0.0",
        "ioredis": "^5.6.0",
        "lru-cache": "^11.0.2",
        "lucide-react": "^1.17.0",
        "motion": "^12.40.0",
        "motion-dom": "^12.40.0",
        "motion-utils": "^12.39.0",
        "next": "15.5.24",
        "openai": "^6.39.0",
        "pdf-parse": "^1.1.1",
        "pino": "^9.14.0",
        "pino-pretty": "^13.1.3",
        "postcss": "^8.4.31",
        "posthog-js": "^1.376.0",
        "prom-client": "^15.1.3",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-hook-form": "^7.54.2",
        "react-hot-toast": "^2.5.2",
        "react-is": "^19.2.7",
        "recharts": "^3.8.1",
        "resend": "^6.12.3",
        "rxjs": "^7.8.2",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "sonner": "^2.0.7",
        "stripe": "^18.0.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^3.4.17",
        "uuid": "^11.1.1",
        "zod": "^3.25.76",
        "zustand": "^5.0.13"
    },
    "devDependencies": {
        "@cyclonedx/cdxgen": "^10.0.0",
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.39.4",
        "@playwright/test": "^1.50.0",
        "@types/file-saver": "^2.0.7",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^22.19.19",
        "@types/pdf-parse": "^1.1.5",
        "@types/react": "^19.1.6",
        "@types/react-dom": "^19.1.5",
        "@typescript-eslint/eslint-plugin": "^8.60.1",
        "@typescript-eslint/parser": "^8.60.1",
        "@vitest/coverage-istanbul": "4.1.8",
        "@vitest/coverage-v8": "^4.1.8",
        "ajv": "^8.17.1",
        "eslint": "^8.57.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "execa": "^10.0.0",
        "fast-check": "^4.8.0",
        "js-yaml": "^4.3.0",
        "json-canonicalize": "^1.2.0",
        "pino-pretty": "^13.1.3",
        "prisma": "6.1.0",
        "tar": "^7.5.21",
        "ts-node": "^10.9.2",
        "tsx": "^4.8.2",
        "typescript": "^5.8.3",
        "vitest": "^4.1.8"
    },
    "resolutions": {
        "tar": "^7.5.21",
        "form-data": "^4.0.6",
        "multer": "^2.2.0",
        "ws": "^8.21.0",
        "js-yaml": "^4.3.0",
        "@opentelemetry/propagator-jaeger": "^2.9.0",
        "fast-uri": "^3.1.4",
        "sharp": "^0.35.0",
        "postcss": "^8.5.18",
        "find-my-way": "^9.7.0",
        "brace-expansion": "^2.0.1",
        "protobufjs": "^8.4.1",
        "minimatch": "^3.1.2"
    },
    "overrides": {
        "tar": "^7.5.21",
        "form-data": "^4.0.6",
        "multer": "^2.2.0",
        "ws": "^8.21.0",
        "js-yaml": "^4.3.0",
        "@opentelemetry/propagator-jaeger": "^2.9.0",
        "fast-uri": "^3.1.4",
        "sharp": "^0.35.0",
        "postcss": "^8.5.18",
        "find-my-way": "^9.7.0",
        "brace-expansion": "^2.0.1",
        "protobufjs": "^8.4.1",
        "minimatch": "^3.1.2",
        "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
        "@opentelemetry/core@<2.8.0": ">=2.8.0",
        "body-parser@>=2.0.0 <2.3.0": ">=2.3.0",
        "dompurify@<=3.4.11": ">=3.4.12",
        "dompurify@<=3.4.10": ">=3.4.11",
        "dompurify@<3.4.9": ">=3.4.9"
    }
}
