{
  "name": "realtime-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "benchmark": "ts-node apps/realtime-gateway/scripts/stress-runtime.ts",
    "cert:run": "tsx ../../scripts/cert-kernel.ts",
    "cert:evaluate": "tsx ../../scripts/cert-evaluator.ts",
    "cert:gate": "tsx ../../scripts/cert-ci-gate.ts",
    "cert:history": "tsx ../../scripts/cert-history.ts",
    "cert:architecture": "tsx ../../scripts/cert-architecture.ts",
    "cert:full": "npm run cert:run && npm run cert:evaluate && npm run cert:gate && npm run cert:architecture",
    "cert:full-history": "npm run cert:full && npm run cert:history"
  },
  "dependencies": {
    "@deepgram/sdk": "^3.13.0",
    "@discordjs/opus": "^0.9.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/websocket": "^11.2.0",
    "@opentelemetry/sdk-node": "^0.54",
    "eventemitter3": "^5",
    "fastify": "^5",
    "openai": "^6.39.0",
    "pino": "^9",
    "pino-pretty": "^13.1.3",
    "werift": "^0.22",
    "ws": "^8",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/ws": "^8",
    "ts-node": "^10",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
