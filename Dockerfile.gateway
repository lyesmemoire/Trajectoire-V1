FROM node:22-alpine AS base
WORKDIR /app
RUN corepack enable

FROM base AS deps
RUN apk add --no-cache python3 make g++
COPY . .
RUN pnpm install --frozen-lockfile

FROM deps AS build
RUN pnpm --filter @trajectoire/execution-core build
RUN pnpm --filter @trajectoire/realtime-core build
RUN pnpm --filter realtime-gateway build

FROM node:22-alpine AS prod
WORKDIR /app
RUN corepack enable
ENV NODE_ENV=production

# pnpm store and external dependencies
COPY --from=deps /app/node_modules ./node_modules

# gateway dependencies and package contract
COPY --from=deps /app/apps/realtime-gateway/node_modules ./apps/realtime-gateway/node_modules
COPY --from=deps /app/apps/realtime-gateway/package.json ./apps/realtime-gateway/package.json

# gateway compiled runtime
COPY --from=build /app/apps/realtime-gateway/dist ./apps/realtime-gateway/dist

# workspace packages required by pnpm workspace links
COPY --from=build /app/packages/execution-core/package.json ./packages/execution-core/package.json
COPY --from=build /app/packages/execution-core/dist ./packages/execution-core/dist
COPY --from=build /app/packages/realtime-core/package.json ./packages/realtime-core/package.json
COPY --from=build /app/packages/realtime-core/dist ./packages/realtime-core/dist

EXPOSE 3000
CMD ["node", "apps/realtime-gateway/dist/index.js"]