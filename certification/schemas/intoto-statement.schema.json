{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "in-toto Statement",
  "type": "object",
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {
      "type": "string",
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "digest"],
        "properties": {
          "name": { "type": "string" },
          "digest": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "predicateType": {
      "type": "string"
    },
    "predicate": {
      "type": "object"
    }
  }
}
