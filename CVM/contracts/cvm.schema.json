        "initializationTime": { "type": "number" },
        "totalTime": { "type": "number" },
        "memoryUsed": { "type": "number" }
      },
      "required": ["loadTime", "parseTime", "dependencyResolutionTime", "resourceLoadTime", "initializationTime", "totalTime", "memoryUsed"]
    },
    "ExecutionOutput": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean" },
        "result": true,
        "metrics": { "$ref": "#/definitions/ExecutionMetrics" },
