        "errors": {
          "type": "array",
          "items": { "$ref": "#/definitions/CVMError" }
        }
      },
      "required": ["success", "result", "metrics", "traceId", "errors"]
    },
    "CVMError": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "$ref": "#/definitions/ErrorType" },
