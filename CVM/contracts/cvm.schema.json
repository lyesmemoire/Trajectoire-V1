    "NetworkMetrics": {
      "type": "object",
      "properties": {
        "requests": { "type": "integer" },
        "bytes": { "type": "integer" },
        "latency": { "type": "number" },
        "errors": { "type": "integer" }
      },
      "required": ["requests", "bytes", "latency", "errors"]
    }
  }
}
