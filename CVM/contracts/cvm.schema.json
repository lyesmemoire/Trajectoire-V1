      },
      "required": ["id", "type", "message", "location"]
    },
    "WarningType": {
      "type": "string",
      "enum": ["DEPRECATED", "PERFORMANCE", "SECURITY", "BEST_PRACTICE"]
    },
    "ValidationInfo": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "$ref": "#/definitions/InfoType" },
        "message": { "type": "string" },
        "location": { "$ref": "#/definitions/ValidationLocation" }
      },
      "required": ["id", "type", "message", "location"]
    },
    "InfoType": {
      "type": "string",
      "enum": ["METADATA", "STATISTICS", "RECOMMENDATION"]
    },
