        "timestamp": { "type": "integer" },
        "stackTrace": { "type": "string" }
      },
      "required": ["id", "type", "message", "timestamp"]
    },
    "ProfileMetrics": {
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "latency": { "$ref": "#/definitions/LatencyMetrics" },
