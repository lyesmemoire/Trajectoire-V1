    "LoadErrorType": {
      "type": "string",
      "enum": ["PARSE_FAILED", "SIGNATURE_VERIFICATION_FAILED", "CHECKSUM_VERIFICATION_FAILED", "DEPENDENCY_RESOLUTION_FAILED", "RESOURCE_LOAD_FAILED", "INITIALIZATION_FAILED", "SANDBOX_SETUP_FAILED"]
    },
    "LoadWarning": {
      "type": "object",
      "properties": {
        "type": { "$ref": "#/definitions/LoadWarningType" },
        "message": { "type": "string" }
      },
      "required": ["type", "message"]
    },
    "LoadWarningType": {
      "type": "string",
      "enum": ["DEPENDENCY_WARNING", "VERSION_WARNING", "COMPATIBILITY_WARNING"]
    },
    "LoadMetrics": {
      "type": "object",
      "properties": {
        "loadTime": { "type": "number" },
        "parseTime": { "type": "number" },
