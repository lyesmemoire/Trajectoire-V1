          "type": "array",
          "items": { "$ref": "#/definitions/LoadError" }
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/definitions/LoadWarning" }
        },
        "metrics": { "$ref": "#/definitions/LoadMetrics" }
      },
      "required": ["success", "packageId", "errors", "warnings", "metrics"]
    },
    "LoadError": {
      "type": "object",
