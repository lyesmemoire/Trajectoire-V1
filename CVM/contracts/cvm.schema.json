        "memory": { "$ref": "#/definitions/MemoryMetrics" },
        "tokens": { "$ref": "#/definitions/TokenMetrics" },
        "network": { "$ref": "#/definitions/NetworkMetrics" }
      },
      "required": ["sessionId", "latency", "cpu", "memory", "tokens", "network"]
    },
    "LatencyMetrics": {
      "type": "object",
      "properties": {
        "total": { "type": "number" },
        "reasoning": { "type": "number" },
        "evidence": { "type": "number" },
        "decision": { "type": "number" },
        "conversation": { "type": "number" },
        "knowledge": { "type": "number" },
        "planning": { "type": "number" },
        "memory": { "type": "number" },
        "llm": { "type": "number" },
        "scheduler": { "type": "number" },
        "compiler": { "type": "number" }
      },
      "required": ["total"]
    },
    "CPUMetrics": {
      "type": "object",
      "properties": {
        "total": { "type": "number" },
