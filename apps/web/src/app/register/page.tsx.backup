  onChange: (k: keyof FormData, v: string | boolean) => void;
  onNext: () => void;
}) {
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const isEmailValid = emailRegex.test(data.email);
  const isPasswordValid = data.password.length >= 8 && /[A-Z]/.test(data.password) && /[a-z]/.test(data.password) && /[0-9]/.test(data.password);
  const valid = isEmailValid && isPasswordValid;

  const handleGoogleLogin = () => {
    trackEvent(ANALYTICS_EVENTS.REGISTER_STARTED, { method: "google" });
    // TODO: Implement Google OAuth
  };

  const handleLinkedInLogin = () => {
    trackEvent(ANALYTICS_EVENTS.REGISTER_STARTED, { method: "linkedin" });
    // TODO: Implement LinkedIn OAuth
  };

  return (
    <motion.div
      key="step1"
      variants={staggerContainer}
      initial="hidden"
      animate="visible"
      exit={{ opacity: 0, x: -20 }}
      className="space-y-7"
    >
      <motion.div variants={fadeInUp}>
        <h2 className="text-3xl font-bold mb-3 tracking-tight" style={{ color: "#111827", fontFamily: FONT_FAMILY.stack, lineHeight: "1.2" }}>
          Prenez le contrôle de votre trajectoire professionnelle.
        </h2>
        <p className="text-base leading-relaxed" style={{ color: COLOR.text.secondary, fontFamily: FONT_FAMILY.stack, lineHeight: "1.6" }}>
          Créez votre compte gratuitement et obtenez une analyse personnalisée de votre progression.
        </p>
      </motion.div>

      {/* Social Login */}
      <motion.div variants={fadeInUp} className="space-y-3">
        <button
          type="button"
          onClick={handleGoogleLogin}
          className="w-full py-3.5 rounded-xl font-medium border transition-all duration-200 flex items-center justify-center gap-3 hover:bg-gray-50 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-gray-400"
          style={{
            borderColor: "#E5E7EB",
            color: "#374151",
            backgroundColor: "#FFFFFF",
            borderRadius: "12px",
            fontFamily: FONT_FAMILY.stack,
            fontSize: "15px",
          }}
          aria-label="Continuer avec Google"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M17.1 9.2c0-.6-.1-1.2-.2-1.8H9v3.4h4.6c-.2 1-.8 1.9-1.7 2.4v2h2.7c1.6-1.5 2.5-3.7 2.5-6z" fill="#4285F4" />
            <path d="M9 18c2.4 0 4.4-.8 5.9-2.1l-2.7-2.1c-.8.5-1.9.9-3.2.9-2.5 0-4.6-1.7-5.3-3.9H.9v2.1C2.4 16.2 5.5 18 9 18z" fill="#34A853" />
            <path d="M3.7 10.8A5.4 5.4 0 0 1 3.7 7.2V5.1H.9A9 9 0 0 0 .9 12.9l2.8-2.1z" fill="#FBBC05" />
            <path d="M9 3.6c1.4 0 2.6.5 3.6 1.4l2.7-2.7A9 9 0 0 0 .9 5.1l2.8 2.1C4.4 5.3 6.5 3.6 9 3.6z" fill="#EA4335" />
          </svg>
          Continuer avec Google
