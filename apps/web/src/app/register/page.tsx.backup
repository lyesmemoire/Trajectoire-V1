"use client";

import { useState, useEffect } from "react";
import Link from "next/link";
import { motion, AnimatePresence } from "framer-motion";
import { staggerContainer, fadeInUp } from "@/lib/motion";
import { SITE_NAME } from "@/lib/constants";
import { useAuth } from "@/hooks/useAuth";
import type { ObjectiveType, PlanType } from "@/types/database";
import { trackEvent } from "@/lib/analytics/trackEvent";
import { ANALYTICS_EVENTS } from "@/lib/analytics/events";
import {
  RadarChart, PolarGrid, PolarAngleAxis, Radar,
  AreaChart, Area, XAxis, YAxis, CartesianGrid,
  BarChart, Bar,
} from "recharts";
import { RADAR_DATA, PROGRESSION_DATA, STRESS_DATA } from "@/lib/constants";
import { ChartContainer } from "@/components/ui";
import { FONT_FAMILY, FONT_SIZE, FONT_WEIGHT, COLOR, SPACE, RADIUS, SHADOW, MOTION } from "@/lib/design-system/tokens";

/* ── Types ── */
type Step = 1 | 2 | 3;

interface FormData {
  email:       string;
  password:    string;
  objective:   string;
  plan:        PlanType;
  acceptTerms: boolean;
}

const OBJECTIVES: { id: ObjectiveType; label: string; icon: string }[] = [
  { id: "promotion",  label: "Préparer une promotion",          icon: "🎯" },
  { id: "interview",  label: "Réussir un entretien interne",    icon: "💼" },
  { id: "transition", label: "Accompagner une transition",      icon: "🔄" },
  { id: "direction",  label: "Prendre un poste de direction",   icon: "🚀" },
  { id: "clarity",    label: "Gagner en clarté sur ma carrière",icon: "🔍" },
  { id: "other",      label: "Autre objectif",                  icon: "✨" },
];

const STEP_LABELS = ["Compte", "Objectif", "Plan"];

/* ── Email validation ── */
function EmailValidation({ email }: { email: string }) {
  if (!email) return null;
  
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const isValid = emailRegex.test(email);
  
  return (
    <p className="text-xs mt-1" style={{ color: isValid ? "var(--success)" : "var(--accent)" }}>
      {isValid ? "✓ Adresse email valide" : "✕ Format invalide"}
    </p>
  );
}

/* ── Password strength ── */
function PasswordStrength({ password }: { password: string }) {
  const checks = [
    password.length >= 8,
    /[A-Z]/.test(password),
    /[a-z]/.test(password),
    /[0-9]/.test(password),
    /[^A-Za-z0-9]/.test(password),
  ];
  const score  = checks.filter(Boolean).length;
  const labels = ["", "Faible", "Moyen", "Fort", "Excellent"];
  const colors = ["", "var(--accent)", "var(--warning)", "var(--success)", "var(--primary)"];

  if (!password) return null;

  return (
    <div className="mt-2">
      <div className="flex gap-1 mb-1">
        {[1, 2, 3, 4].map((i) => (
          <div
            key={i}
            className="flex-1 h-1 rounded-full transition-all duration-300"
            style={{ backgroundColor: i <= score ? colors[score] : "var(--border)" }}
          />
        ))}
      </div>
      <p className="text-xs" style={{ color: score >= 3 ? "var(--success)" : "var(--muted)" }}>
        {score > 0 ? `Sécurité : ${labels[score]}` : ""}
      </p>
      <div className="flex flex-wrap gap-2 mt-2">
        {[
          { check: checks[0], label: "8+ caractères" },
          { check: checks[1], label: "Majuscule" },
          { check: checks[2], label: "Minuscule" },
          { check: checks[3], label: "Chiffre" },
          { check: checks[4], label: "Spécial" },
        ].map(({ check, label }) => (
          <span key={label} className="text-xs" style={{ color: check ? "var(--success)" : "var(--muted)" }}>
            {check ? "✓" : "○"} {label}
          </span>
        ))}
      </div>
    </div>
  );
}

/* ── Step indicator ── */
function StepIndicator({ current, total }: { current: Step; total: number }) {
  return (
    <div className="flex items-center gap-2" aria-label={`Étape ${current} sur ${total}`}>
      {Array.from({ length: total }, (_, i) => {
        const step = (i + 1) as Step;
        const done   = step < current;
        const active = step === current;
        return (
          <div key={i} className="flex items-center gap-2">
            <div
              className="w-7 h-7 rounded-full flex items-center justify-center text-xs font-semibold transition-all duration-300"
              style={{
                backgroundColor: done ? "var(--success)" : active ? "var(--primary)" : "var(--border)",
                color: done || active ? "white" : "var(--muted)",
              }}
              aria-current={active ? "step" : undefined}
            >
              {done ? (
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 6l3 3 5-5" stroke="white" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" />
                </svg>
              ) : step}
            </div>
            {i < total - 1 && (
              <div
                className="w-8 h-px transition-all duration-300"
                style={{ backgroundColor: done ? "var(--success)" : "var(--border)" }}
                aria-hidden="true"
              />
            )}
          </div>
        );
      })}
    </div>
  );
}

/* ── Input helpers ── */
const inputBase: React.CSSProperties = {
  backgroundColor: COLOR.surface.muted,
  border: `1px solid ${COLOR.border.default}`,
  color: COLOR.text.primary,
  fontFamily: FONT_FAMILY.stack,
  fontSize: FONT_SIZE.md,
};

function onFocusStyle(e: React.FocusEvent<HTMLInputElement | HTMLSelectElement>) {
  e.currentTarget.style.borderColor = COLOR.border.focus;
  e.currentTarget.style.boxShadow   = `0 0 0 3px ${COLOR.brand.primary}15`;
}
function onBlurStyle(e: React.FocusEvent<HTMLInputElement | HTMLSelectElement>) {
  e.currentTarget.style.borderColor = COLOR.border.default;
  e.currentTarget.style.boxShadow   = "none";
}

/* ── Dashboard Preview Component ── */
function DashboardPreview() {
  const [mounted, setMounted] = useState(false);

  useEffect(() => {
    setMounted(true);
  }, []);

  return (
    <div className="bg-white rounded-3xl border h-full flex flex-col overflow-hidden relative" style={{ borderColor: COLOR.border.default, boxShadow: SHADOW[3] }}>
      {/* Subtle gradient overlay */}
      <div 
        className="absolute inset-0 pointer-events-none opacity-50"
        style={{
          background: `radial-gradient(ellipse 80% 50% at -20% 0%, ${COLOR.brand.primary}05 0%, transparent 50%), radial-gradient(ellipse 60% 40% at 100% 100%, ${COLOR.brand.accent}03 0%, transparent 50%)`
        }}
      />
      
      <div className="relative p-8">
        <div className="flex items-center gap-3 mb-8">
          <div className="flex gap-1.5" aria-hidden="true">
            <div className="w-3 h-3 rounded-full bg-[var(--color-danger)] shadow-sm" />
            <div className="w-3 h-3 rounded-full bg-[var(--color-warning)] shadow-sm" />
            <div className="w-3 h-3 rounded-full bg-[var(--color-success)] shadow-sm" />
          </div>
          <span className="text-sm font-medium text-ink-muted/80 tracking-tight">trajectoire.app/dashboard</span>
        </div>

        {/* KPI Cards */}
        <div className="grid grid-cols-2 gap-4 mb-8">
          {[
            { label: "Confiance", value: "78", unit: "/100", trend: "+12" },
            { label: "Stress", value: "32", unit: "%", trend: "-8" },
            { label: "Préparation", value: "85", unit: "/100", trend: "+5" },
            { label: "Décision", value: "91", unit: "/100", trend: "+3" },
          ].map((kpi) => (
            <div key={kpi.label} className="rounded-2xl p-4 border shadow-sm" style={{ background: `linear-gradient(to bottom right, ${COLOR.surface.elevated}, ${COLOR.surface.muted})`, borderColor: COLOR.border.muted, borderRadius: RADIUS.lg }}>
              <p className="text-[11px] font-semibold uppercase tracking-wider mb-2" style={{ color: COLOR.text.secondary, fontFamily: FONT_FAMILY.stack }}>{kpi.label}</p>
              <div className="flex items-baseline gap-1.5">
                <span className="text-2xl font-bold tracking-tight" style={{ color: COLOR.brand.primary, fontFamily: FONT_FAMILY.stack }}>{kpi.value}</span>
                <span className="text-xs" style={{ color: COLOR.text.secondary, fontFamily: FONT_FAMILY.stack }}>{kpi.unit}</span>
              </div>
              <p className="text-[10px] font-medium mt-1" style={{ color: kpi.trend.startsWith('+') ? COLOR.semantic.success : COLOR.brand.accent, fontFamily: FONT_FAMILY.stack }}>
                {kpi.trend} pts
              </p>
            </div>
          ))}
        </div>

        {/* Radar Chart */}
        <div className="rounded-2xl p-5 mb-5 flex-1 min-h-[200px] border shadow-sm" style={{ background: `linear-gradient(to bottom right, ${COLOR.surface.elevated}, ${COLOR.surface.muted})`, borderColor: COLOR.border.muted, borderRadius: RADIUS.lg }}>
          <p className="text-sm font-bold mb-4 tracking-tight" style={{ color: COLOR.text.primary, fontFamily: FONT_FAMILY.stack }}>Analyse comportementale</p>
          {mounted ? (
            <ChartContainer height={160}>
              <RadarChart data={RADAR_DATA}>
                <PolarGrid stroke="var(--color-border)" strokeWidth={0.5} />
                <PolarAngleAxis
                  dataKey="subject"
                  tick={{ fontSize: 10, fill: "var(--color-ink-muted)", fontWeight: 500 }}
                />
                <Radar
                  name="Profil"
                  dataKey="value"
                  stroke="var(--color-brand-primary)"
                  fill="var(--color-brand-primary)"
                  fillOpacity={0.2}
                  strokeWidth={2.5}
                />
              </RadarChart>
            </ChartContainer>
          ) : null}
        </div>

        {/* Progression Chart */}
        <div className="rounded-2xl p-5 flex-1 min-h-[160px] border shadow-sm" style={{ background: `linear-gradient(to bottom right, ${COLOR.surface.elevated}, ${COLOR.surface.muted})`, borderColor: COLOR.border.muted, borderRadius: RADIUS.lg }}>
          <p className="text-sm font-bold mb-4 tracking-tight" style={{ color: COLOR.text.primary, fontFamily: FONT_FAMILY.stack }}>Progression</p>
          {mounted ? (
            <ChartContainer height={120}>
              <AreaChart data={PROGRESSION_DATA} margin={{ top: 8, right: 8, left: -15, bottom: 0 }}>
                <defs>
                  <linearGradient id="gConf" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="5%" stopColor="var(--color-brand-primary)" stopOpacity={0.25} />
                    <stop offset="95%" stopColor="var(--color-brand-primary)" stopOpacity={0} />
                  </linearGradient>
                </defs>
                <CartesianGrid strokeDasharray="4 4" vertical={false} stroke="var(--color-border)" strokeWidth={0.5} />
                <XAxis
                  dataKey="week"
                  tick={{ fontSize: 10, fill: "var(--color-ink-muted)", fontWeight: 500 }}
                  axisLine={false}
                  tickLine={false}
                />
                <YAxis hide />
                <Area
                  type="monotone"
                  dataKey="confidence"
                  stroke="var(--color-brand-primary)"
                  strokeWidth={2.5}
                  fill="url(#gConf)"
                />
              </AreaChart>
            </ChartContainer>
          ) : null}
        </div>
      </div>
    </div>
  );
}

/* ── Step 1: Account Creation (Simplified) ── */
function StepOne({
