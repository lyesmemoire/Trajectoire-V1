          style={{
            borderColor: "#E5E7EB",
            color: "#374151",
            backgroundColor: "#FFFFFF",
            borderRadius: "12px",
            fontFamily: FONT_FAMILY.stack,
            fontSize: "15px",
          }}
          aria-label="Continuer avec LinkedIn"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M16 0H2a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V2a2 2 0 00-2-2zM6 14H3V7h3v7zM4.5 5.8A1.8 1.8 0 114.5 2.2a1.8 1.8 0 010 3.6zM15 14h-3v-3.5c0-1.4-.5-2.3-1.7-2.3-.9 0-1.5.6-1.7 1.2-.1.2-.1.5-.1.8V14H5V7h3v1c.4-.6 1.2-1 2.5-1 2.7 0 4.5 1.8 4.5 5.3V14z" fill="#0077B5" />
