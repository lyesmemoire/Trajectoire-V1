    "benchmark:artillery:api": "artillery run benchmarks/artillery/api-load-test.yml",
    "benchmark:artillery:graph": "artillery run benchmarks/artillery/graph-load-test.yml",
    "benchmark:artillery:search": "artillery run benchmarks/artillery/search-load-test.yml",
