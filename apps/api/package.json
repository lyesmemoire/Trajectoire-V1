    "benchmark:artillery:redis": "artillery run benchmarks/artillery/redis-load-test.yml",
    "benchmark:artillery:postgres": "artillery run benchmarks/artillery/postgres-load-test.yml",
    "benchmark:artillery:openai": "artillery run benchmarks/artillery/openai-load-test.yml",
    "benchmark:artillery:all": "artillery run benchmarks/artillery/api-load-test.yml && artillery run benchmarks/artillery/graph-load-test.yml && artillery run benchmarks/artillery/search-load-test.yml && artillery run benchmarks/artillery/matching-load-test.yml && artillery run benchmarks/artillery/copilot-load-test.yml && artillery run benchmarks/artillery/redis-load-test.yml && artillery run benchmarks/artillery/postgres-load-test.yml && artillery run benchmarks/artillery/openai-load-test.yml",
    "benchmark:autocannon:api": "node benchmarks/autocannon/api-load-test.js",
    "benchmark:autocannon:graph": "node benchmarks/autocannon/graph-load-test.js",
    "benchmark:autocannon:search": "node benchmarks/autocannon/search-load-test.js",
    "benchmark:autocannon:matching": "node benchmarks/autocannon/matching-load-test.js",
    "benchmark:autocannon:copilot": "node benchmarks/autocannon/copilot-load-test.js",
    "benchmark:autocannon:all": "node benchmarks/autocannon/api-load-test.js && node benchmarks/autocannon/graph-load-test.js && node benchmarks/autocannon/search-load-test.js && node benchmarks/autocannon/matching-load-test.js && node benchmarks/autocannon/copilot-load-test.js",
