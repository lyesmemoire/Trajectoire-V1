{
  "compilerOptions": {
    "composite": false,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["../../lib/*"]
    }
  },
  "include": ["src/index.ts", "src/server/**/*", "src/telemetry/**/*", "src/ai/**/*"],
  "exclude": ["node_modules", "dist"]
}