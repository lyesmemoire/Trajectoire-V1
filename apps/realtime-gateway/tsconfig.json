{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "module":  "NodeNext",
                            "moduleResolution":  "NodeNext",
                            "lib":  [
                                        "ES2022",
                                        "DOM",
                                        "DOM.Iterable"
                                    ],
                            "outDir":  "dist",
                            "strict":  false,
                            "exactOptionalPropertyTypes":  false,
                            "skipLibCheck":  true,
                            "esModuleInterop":  true,
                            "resolveJsonModule":  true,
                            "declaration":  true,
                            "declarationMap":  true,
                            "sourceMap":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "jsx":  "react-jsx",
                            "noEmitOnError":  false,
                            "noImplicitAny":  false,
                            "useUnknownInCatchVariables":  false
                        },
    "include":  [
                    "src/**/*"
                ],
    "exclude":  [
                    "node_modules",
                    "dist",
                    "src/interview/**/*",
                    "src/__tests__/**/*",
                    "src/scripts/**/*",
                    "../../core/p5",
                    "../../core/p6",
                    "../../lib"
                ]
}
