# Realtime gateway environment contract.
# Development defaults are intentionally local.
# Production rejects localhost origins and frontend URLs.

NODE_ENV="development"
PORT="3001"

# Speech-to-text
DEEPGRAM_API_KEY=""

# Required in production
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"

# Required in production for rate limits and WebSocket guards
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional TURN/WebRTC
TURN_URL=""
TURN_USERNAME=""
TURN_PASSWORD=""
