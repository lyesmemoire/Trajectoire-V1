generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

model User {
  id                     String                   @id @default(cuid())
  email                  String                   @unique
  name                   String?
  image                  String?
  emailVerified          DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  role                   UserRole                 @default(USER)
  plan                   Plan                     @default(FREE)
  stripeCustomerId       String?                  @unique
  referralCode           String                   @unique
  referredBy             String?
  referralCount          Int                      @default(0)
  monthlyAnalysisCount   Int                      @default(0)
  monthlyResetDate       DateTime                 @default(dbgenerated("(now() + '1 mon'::interval)"))
  credits                Int                      @default(100)
  onboardingCompleted    Boolean                  @default(false)
  opportunities          Opportunity[]
  applicationWorkspaces  ApplicationWorkspace[]
  careerStories          CareerStory[]
  careerMemories         CareerMemory[]
  AIUsageLog             AIUsageLog[]
  Account                Account[]
  AdminAuditLog          AdminAuditLog[]
  BehaviorEvent          BehaviorEvent[]
  BehavioralPattern      BehavioralPattern[]
  CVAnalysis             CVAnalysis[]
  careerProfile          CareerProfile?
  graphs                 Graph[]
  interviewSessions      InterviewSession[]
  PublicChallengeEntry   PublicChallengeEntry[]
  RecoveryEmailLog       RecoveryEmailLog[]
  Session                Session[]
  Subscription           Subscription?
  UserAnalytics          UserAnalytics?
  UserBehaviorProfile    UserBehaviorProfile?
  UserPredictionSnapshot UserPredictionSnapshot[]
  WaitlistEntry          WaitlistEntry?
  discoveredJobs         DiscoveredJob[]

  discoverySources DiscoverySource[]

  @@index([email])
  @@index([stripeCustomerId])
  @@index([monthlyResetDate])
  @@map("users")
  @@schema("public")
}

model CareerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  employabilityScore Float    @default(0)
  clarityTrend       Float?
  confidenceTrend    Float?
  ownershipTrend     Float?
  stressResistance   Float?
  leadershipScore    Float?
  communicationScore Float?
  careerDNA          Json?
  unlockedPersonas   String[]
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model InterviewSession {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()"))
  userId                String
  persona               String
  currentState          String
  clarityScore          Float?
  confidenceScore       Float?
  ownershipScore        Float?
  specificityScore      Float?
  pressureLevel         Int                    @default(0)
  authenticityScore     Float                  @default(1.0)
  jobTitle              String?
  company               String?
  score                 Int?
  status                String                 @default("active")
  questions             Json?
  answers               Json?
  analysis              Json?
  startedAt             DateTime               @default(now())
  completedAt           DateTime?
  createdAt             DateTime               @default(now())
  careerTrajectoryScore Float?                 @map("career_trajectory_score")
  challengeEntryId      String?
  BehaviorEvent         BehaviorEvent[]
  InterviewEvent        InterviewEvent[]
  PublicChallengeEntry  PublicChallengeEntry?  @relation(fields: [challengeEntryId], references: [id])
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationWorkspaces ApplicationWorkspace[]

  careerStories CareerStory[]

  careerMemories CareerMemory[]

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@schema("public")
}

model AIUsageLog {
  id              String   @id @default(cuid())
  userId          String?
  sessionId       String?
  provider        String
  model           String
  feature         String
  tokensInput     Int
  tokensOutput    Int
  latencyMs       Int
  costUsd         Float
  cacheHit        Boolean  @default(false)
  confidenceScore Float?
  failureType     String?
  createdAt       DateTime @default(now())
  User            User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@schema("public")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@schema("public")
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  targetId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  User      User     @relation(fields: [adminId], references: [id])

  @@index([action])
  @@index([adminId])
  @@schema("public")
}

model BehaviorEvent {
  id               String           @id @default(cuid())
  userId           String
  sessionId        String
  type             String
  subtype          String?
  timestamp        DateTime         @default(now())
  payload          Json
  latencyMs        Int?
  intensityScore   Float?
  entropyScore     Float?
  previousEventId  String?
  nextEventId      String?
  InterviewSession InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  User             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId, type])
  @@schema("public")
}

model BehavioralPattern {
  id          String   @id @default(cuid())
  userId      String
  pattern     String
  frequency   Int      @default(1)
  severity    Float
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model CVAnalysis {
  id                    String                 @id @default(cuid())
  userId                String
  fileName              String
  originalText          String
  optimizedText         String
  cvData                Json
  atsScoreBefore        Int?
  atsScoreAfter         Int?
  improvements          Json?
  keywords              Json?
  createdAt             DateTime               @default(now())
  User                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationWorkspaces ApplicationWorkspace[]

  careerStories CareerStory[]

  careerMemories CareerMemory[]

  @@index([userId])
  @@schema("public")
}

model InterviewEvent {
  id               String           @id @default(cuid())
  sessionId        String
  type             String
  impactScore      Float?
  createdAt        DateTime         @default(now())
  InterviewSession InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model ProcessedWebhook {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  @@schema("public")
}

model PreviewAnalysis {
  id              String    @id @default(cuid())
  token           String    @unique
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  ipHash          String
  fingerprint     String
  consumed        Boolean   @default(false)
  analysisResult  Json?     @map("analysis_result")
  atsScore        Int?      @map("ats_score")
  claimedAt       DateTime? @map("claimed_at")
  claimedByUserId String?   @map("claimed_by_user_id")
  consumedAt      DateTime? @map("consumed_at")
  cvExtract       Json?     @map("cv_extract")
  jobExtract      Json?     @map("job_extract")
  rawPayload      Json?     @map("raw_payload")
  recommendations Json?     @map("recommendations")
  status          String    @default("pending")
  strengths       Json?     @map("strengths")
  weaknesses      Json?     @map("weaknesses")

  @@index([token])
  @@index([expiresAt])
  @@index([consumed])
  @@index([claimedByUserId])
  @@index([claimedByUserId, consumed])
  @@index([status, expiresAt])
  @@schema("public")
}

model PromptVersion {
  id        String   @id @default(cuid())
  type      String
  version   String
  content   String
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@schema("public")
}

model PublicChallenge {
  id                   String                 @id @default(cuid())
  slug                 String                 @unique
  name                 String
  description          String
  type                 String
  startDate            DateTime
  endDate              DateTime
  isActive             Boolean                @default(true)
  config               Json
  rewardCredits        Int                    @default(0)
  rewardBadgeId        String?
  PublicChallengeEntry PublicChallengeEntry[]

  @@schema("public")
}

model PublicChallengeEntry {
  id               String             @id @default(cuid())
  challengeId      String
  userId           String
  bestScore        Int                @default(0)
  maxPressure      Int                @default(0)
  interruptions    Int                @default(0)
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  InterviewSession InterviewSession[]
  PublicChallenge  PublicChallenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  User             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@schema("public")
}

model RecoveryEmailLog {
  id        String   @id @default(cuid())
  userId    String
  riskLevel String
  cause     String
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("public")
}

model Subscription {
  id               String   @id @default(cuid())
  userId           String   @unique
  stripeCustomerId String
  stripeSubId      String   @unique
  status           String
  currentPeriodEnd DateTime
  plan             Plan     @default(FREE)
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  User             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model UserAnalytics {
  id              String    @id @default(cuid())
  userId          String    @unique
  activationScore Int       @default(0)
  churnRisk       Float     @default(0)
  viralityScore   Float     @default(0)
  engagementScore Float     @default(0)
  lastActiveAt    DateTime?
  updatedAt       DateTime
  User            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model UserBehaviorProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  pressureType        String?
  weaknessPattern     String?
  targetArchetype     String?
  returnProbability   Float?
  returnSegment       String?
  lastPredictionDate  DateTime?
  onboardingCompleted Boolean   @default(false)
  createdAt           DateTime  @default(now())
  User                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model UserPredictionSnapshot {
  id                String   @id @default(cuid())
  userId            String
  sessionId         String
  returnProbability Float
  returnSegment     String
  primaryDriver     String
  stressScore       Float?
  recoveryScore     Float?
  engagementScore   Float?
  createdAt         DateTime @default(now())
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([returnSegment])
  @@index([userId])
  @@schema("public")
}

model WaitlistEntry {
  id               String   @id @default(cuid())
  email            String   @unique
  userId           String?  @unique
  source           String?
  createdAt        DateTime @default(now())
  converted        Boolean  @default(false)
  pressureType     String?
  weakness         String?
  intentReason     String?
  isWillingToRetry Boolean  @default(false)
  status           String   @default("PENDING")
  User             User?    @relation(fields: [userId], references: [id])

  @@schema("public")
}

model PremiumInterviewSession {
  id                    String    @id @default(uuid())
  userId                String?
  analysisId            String?
  interviewType         String    @default("standard")
  status                String    @default("active")
  score                 Int       @default(0)
  questions             Json?
  answers               Json?
  feedback              Json?
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  careerTrajectoryScore Float?

  @@map("premium_interview_sessions")
  @@schema("public")
}

model SimulationSession {
  id         String   @id @default(cuid())
  userId     String?
  createdAt  DateTime @default(now())
  overall    Int
  percentile Int
  scores     Json
  level      String

  @@schema("public")
}

model CreditTransaction {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key")
  userId         String   @map("user_id")
  amount         Int
  action         String
  state          tx_state @default(reserved)
  tokensUsed     Int      @default(0) @map("tokens_used")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("credit_transactions")
  @@schema("public")
}

model CreditUsage {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action           String
  creditsSpent     Int      @map("credits_spent")
  tokensUsed       Int      @default(0) @map("tokens_used")
  estimatedCostEur Decimal  @default(0) @map("estimated_cost_eur") @db.Decimal(10, 6)
  metadata         Json?    @default("{}")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  userId           String   @map("user_id") @db.Uuid

  @@map("credit_usage")
  @@schema("public")
}

model StripeEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String   @unique @map("event_id")
  creditsAdded Int?     @map("credits_added")
  processedAt  DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  userId       String?  @map("user_id") @db.Uuid

  @@map("stripe_events")
  @@schema("public")
}

model Idempotency {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey String    @map("idempotency_key")
  userId         String    @map("user_id")
  operation      String
  requestParams  Json      @map("request_params")
  resultRef      String?   @map("result_ref")
  status         String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)

  @@unique([idempotencyKey, userId, operation], name: "idempotency_key_user_op_unique")
  @@index([expiresAt], map: "idx_idempotency_expires_at")
  @@map("idempotency")
  @@schema("public")
}

model CvRewrite {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id")
  idempotencyKey   String   @unique @map("idempotency_key")
  action           String
  originalContent  String   @map("original_content")
  rewrittenContent String   @map("rewritten_content")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
  @@map("cv_rewrites")
  @@schema("public")
}

model Graph {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  name        String
  description String?
  version     Int             @default(1)
  isActive    Boolean         @default(true) @map("is_active")
  source      String          @default("MANUAL")
  metadata    Json?           @default("{}")
  deletedAt   DateTime?       @map("deleted_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  edges       GraphEdge[]
  nodes       GraphNode[]
  snapshots   GraphSnapshot[]
  versions    GraphVersion[]

  @@index([userId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([source])
  @@index([createdAt])
  @@index([isActive, source])
  @@index([userId, isActive])
  @@map("graphs")
  @@schema("public")
}

model GraphNode {
  id              String                 @id @default(cuid())
  graphId         String                 @map("graph_id")
  nodeId          String                 @map("node_id")
  type            String
  label           String
  normalizedLabel String                 @map("normalized_label")
  confidence      Float                  @default(0.5)
  source          String
  metadata        Json?                  @default("{}")
  embedding       Unsupported("vector")?
  deletedAt       DateTime?              @map("deleted_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  outgoingEdges   GraphEdge[]            @relation("OutgoingEdges")
  incomingEdges   GraphEdge[]            @relation("IncomingEdges")
  graph           Graph                  @relation(fields: [graphId], references: [id], onDelete: Cascade)

  @@index([graphId])
  @@index([type])
  @@index([normalizedLabel])
  @@index([confidence])
  @@index([deletedAt])
  @@index([graphId, type])
  @@index([graphId, normalizedLabel])
  @@index([graphId, type, confidence])
  @@index([graphId, deletedAt])
  @@map("graph_nodes")
  @@schema("public")
}

model GraphEdge {
  id           String    @id @default(cuid())
  graphId      String    @map("graph_id")
  edgeId       String    @map("edge_id")
  type         String
  sourceNodeId String    @map("source_node_id")
  targetNodeId String    @map("target_node_id")
  weight       Float     @default(0.5)
  confidence   Float     @default(0.5)
  reason       String?
  metadata     Json?     @default("{}")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  graph        Graph     @relation(fields: [graphId], references: [id], onDelete: Cascade)
  sourceNode   GraphNode @relation("OutgoingEdges", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   GraphNode @relation("IncomingEdges", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([graphId])
  @@index([type])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([weight])
  @@index([confidence])
  @@index([deletedAt])
  @@index([graphId, type])
  @@index([graphId, sourceNodeId])
  @@index([graphId, targetNodeId])
  @@index([sourceNodeId, targetNodeId])
  @@index([graphId, type, weight])
  @@index([graphId, deletedAt])
  @@map("graph_edges")
  @@schema("public")
}

model GraphVersion {
  id          String   @id @default(cuid())
  graphId     String   @map("graph_id")
  version     Int
  description String?
  changeLog   Json?    @default("{}")
  nodeCount   Int      @default(0) @map("node_count")
  edgeCount   Int      @default(0) @map("edge_count")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  graph       Graph    @relation(fields: [graphId], references: [id], onDelete: Cascade)

  @@unique([graphId, version])
  @@index([graphId])
  @@index([version])
  @@index([createdAt])
  @@index([graphId, version])
  @@map("graph_versions")
  @@schema("public")
}

model GraphSnapshot {
  id          String   @id @default(cuid())
  graphId     String   @map("graph_id")
  version     Int
  name        String
  description String?
  nodeData    Json     @map("node_data")
  edgeData    Json     @map("edge_data")
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  graph       Graph    @relation(fields: [graphId], references: [id], onDelete: Cascade)

  @@index([graphId])
  @@index([version])
  @@index([createdAt])
  @@index([graphId, version])
  @@map("graph_snapshots")
  @@schema("public")
}

model DataLineage {
  uuid                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceType                String   @map("source_type")
  sourceOrigin              String   @map("source_origin")
  sourceProvenance          String   @map("source_provenance")
  sourcePipeline            String   @map("source_pipeline")
  sourceStage               String   @map("source_stage")
  sourceTimestamp           DateTime @map("source_timestamp") @db.Timestamptz(6)
  transformationType        String   @map("transformation_type")
  transformationParameters  Json?    @default("{}") @map("transformation_parameters")
  transformationDescription String   @map("transformation_description")
  hash                      String
  graphNodeId               String?  @map("graph_node_id") @db.Uuid
  relationType              String?  @map("relation_type")
  relationTargetUuid        String?  @map("relation_target_uuid") @db.Uuid
  relationName              String?  @map("relation_name")
  parentUuid                String?  @map("parent_uuid") @db.Uuid
  storageType               String   @map("storage_type")
  storageLocation           String   @map("storage_location")
  confidence                Float    @default(0.5)
  timestamp                 DateTime @default(now()) @db.Timestamptz(6)
  metadata                  Json?    @default("{}")

  @@index([sourceType])
  @@index([transformationType])
  @@index([relationType])
  @@index([storageType])
  @@index([graphNodeId])
  @@index([timestamp])
  @@index([confidence])
  @@index([hash])
  @@index([parentUuid, timestamp])
  @@index([graphNodeId, timestamp])
  @@map("data_lineage")
  @@schema("public")
}

model Opportunity {
  id                  String                @id @default(cuid())
  userId              String
  title               String
  company             String?
  location            String?
  sourceUrl           String?
  source              String?
  description         String
  status              OpportunityStatus     @default(DISCOVERED)
  matchScore          Int?
  skillsScore         Int?
  experienceScore     Int?
  seniorityScore      Int?
  relevanceScore      Int?
  recommendation      String?
  recommendationLabel String?
  strengths           Json?
  gaps                Json?
  analysis            Json?
  metadata            Json?
  discoveredAt        DateTime              @default(now())
  analyzedAt          DateTime?
  appliedAt           DateTime?
  interviewAt         DateTime?
  offerAt             DateTime?
  rejectedAt          DateTime?
  archivedAt          DateTime?
  nextAction          String?
  nextActionAt        DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace           ApplicationWorkspace?

  stories OpportunityStory[]

  memories       OpportunityMemory[]
  discoveredJobs DiscoveredJob[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, matchScore])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([status])
  @@index([createdAt])
  @@map("opportunities")
  @@schema("public")
}

enum OpportunityStatus {
  DISCOVERED
  TO_ANALYZE
  TO_APPLY
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  ARCHIVED

  @@schema("public")
}

enum UserRole {
  USER
  ADMIN_SUPPORT
  ADMIN_PRODUCT
  ADMIN_FOUNDER

  @@schema("public")
}

enum Plan {
  FREE
  PRO
  EXPERT

  @@schema("public")
}

enum tx_state {
  reserved
  committed
  rolled_back
  expired

  @@schema("public")
}

model ApplicationWorkspace {
  id                   String             @id @default(cuid())
  userId               String
  opportunityId        String             @unique
  selectedCVAnalysisId String?
  interviewSessionId   String?
  readiness            WorkspaceReadiness @default(SETUP)
  companyResearch      Json?
  preparation          Json?
  tasks                Json?
  notes                String?
  metadata             Json?
  lastActivityAt       DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity        Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  selectedCVAnalysis CVAnalysis?       @relation(fields: [selectedCVAnalysisId], references: [id], onDelete: SetNull)
  interviewSession   InterviewSession? @relation(fields: [interviewSessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([selectedCVAnalysisId])
  @@index([interviewSessionId])
  @@map("application_workspaces")
  @@schema("public")
}

enum WorkspaceReadiness {
  SETUP
  IN_PROGRESS
  READY
  INTERVIEWING
  COMPLETED
  ARCHIVED

  @@schema("public")
}

model CareerStory {
  id         String   @id @default(cuid())
  userId     String
  title      String
  situation  String
  task       String
  action     String
  result     String
  skills     String[]
  tags       String[]
  metrics    Json?
  source     String?
  confidence Int      @default(100)
  isFavorite Boolean  @default(false)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities      OpportunityStory[]
  InterviewSession   InterviewSession?  @relation(fields: [interviewSessionId], references: [id])
  interviewSessionId String?
  CVAnalysis         CVAnalysis?        @relation(fields: [cVAnalysisId], references: [id])
  cVAnalysisId       String?

  @@index([userId])
  @@index([userId, isFavorite])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("career_stories")
  @@schema("public")
}

model OpportunityStory {
  id            String   @id @default(cuid())
  opportunityId String
  storyId       String
  relevance     Int?
  reason        String?
  selected      Boolean  @default(true)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  story       CareerStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, storyId])
  @@index([opportunityId])
  @@index([storyId])
  @@index([opportunityId, selected])
  @@map("opportunity_stories")
  @@schema("public")
}

model CareerMemory {
  id         String             @id @default(cuid())
  userId     String
  category   String
  key        String
  value      String
  origin     CareerMemoryOrigin @default(USER_CONFIRMED)
  status     CareerMemoryStatus @default(CONFIRMED)
  confidence Int                @default(100)
  evidence   Json?
  sourceType String?
  sourceId   String?
  isFavorite Boolean            @default(false)
  metadata   Json?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities      OpportunityMemory[]
  InterviewSession   InterviewSession?   @relation(fields: [interviewSessionId], references: [id])
  interviewSessionId String?
  CVAnalysis         CVAnalysis?         @relation(fields: [cVAnalysisId], references: [id])
  cVAnalysisId       String?

  @@unique([userId, category, key])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, isFavorite])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("career_memories")
  @@schema("public")
}

model OpportunityMemory {
  id            String   @id @default(cuid())
  opportunityId String
  memoryId      String
  relevance     Int?
  reason        String?
  selected      Boolean  @default(false)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  opportunity Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  memory      CareerMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, memoryId])
  @@index([opportunityId])
  @@index([memoryId])
  @@index([opportunityId, selected])
  @@map("opportunity_memories")
  @@schema("public")
}

enum CareerMemoryOrigin {
  USER_CONFIRMED
  AI_DERIVED
  IMPORTED

  @@schema("public")
}

enum CareerMemoryStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
  ARCHIVED

  @@schema("public")
}

enum DiscoveryProvider {
  GREENHOUSE
  LEVER
  ASHBY
  OTHER

  @@schema("public")
}

enum DiscoveryJobStatus {
  LIVE
  STALE
  CLOSED

  @@schema("public")
}

model DiscoverySource {
  id             String            @id @default(cuid())
  userId         String
  provider       DiscoveryProvider
  company        String
  boardKey       String
  enabled        Boolean           @default(true)
  lastSyncAt     DateTime?
  lastSyncStatus String?
  lastSyncError  String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, boardKey])
  @@index([userId])
  @@index([userId, enabled])
  @@index([provider, boardKey])
  @@map("discovery_sources")
  @@schema("public")
}

model DiscoveredJob {
  id             String             @id @default(cuid())
  userId         String
  opportunityId  String?
  provider       DiscoveryProvider
  sourceKey      String
  externalId     String
  boardKey       String
  title          String
  company        String
  location       String?
  department     String?
  employmentType String?
  workplaceType  String?
  description    String
  sourceUrl      String
  applyUrl       String?
  fingerprint    String
  status         DiscoveryJobStatus @default(LIVE)
  publishedAt    DateTime?
  firstSeenAt    DateTime           @default(now())
  lastSeenAt     DateTime           @default(now())
  closedAt       DateTime?
  rawPayload     Json?
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@unique([userId, provider, sourceKey])
  @@index([userId])
  @@index([userId, status, lastSeenAt(sort: Desc)])
  @@index([userId, fingerprint])
  @@index([opportunityId])
  @@index([provider, boardKey])
  @@map("discovered_jobs")
  @@schema("public")
}
