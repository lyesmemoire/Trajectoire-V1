generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                   @id @default(cuid())
  email                  String                   @unique
  name                   String?
  image                  String?
  emailVerified          DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime @updatedAt
  role                   UserRole                 @default(USER)
  plan                   Plan                     @default(FREE)
  stripeCustomerId       String?                  @unique
  referralCode           String                   @unique
  referredBy             String?
  referralCount          Int                      @default(0)
  monthlyAnalysisCount   Int                      @default(0)
  monthlyResetDate       DateTime                 @default(dbgenerated("(NOW() + INTERVAL '1 month')"))
  credits                Int                      @default(100)
  onboardingCompleted    Boolean                  @default(false)
  AIUsageLog             AIUsageLog[]
  Account                Account[]
  AdminAuditLog          AdminAuditLog[]
  BehaviorEvent          BehaviorEvent[]
  BehavioralPattern      BehavioralPattern[]
  CVAnalysis             CVAnalysis[]
  careerProfile          CareerProfile?
  interviewSessions      InterviewSession[]
  PublicChallengeEntry   PublicChallengeEntry[]
  RecoveryEmailLog       RecoveryEmailLog[]
  Session                Session[]
  Subscription           Subscription?
  UserAnalytics          UserAnalytics?
  UserBehaviorProfile    UserBehaviorProfile?
  UserPredictionSnapshot UserPredictionSnapshot[]
  WaitlistEntry          WaitlistEntry?

  @@index([email])
  @@index([stripeCustomerId])
  @@index([monthlyResetDate])
  @@index([plan, credits]) // OPTIMIZED: Composite index for plan and credits filtering
  @@index([role, plan]) // OPTIMIZED: Composite index for admin queries
}

model CareerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  employabilityScore Float    @default(0)
  clarityTrend       Float?
  confidenceTrend    Float?
  ownershipTrend     Float?
  stressResistance   Float?
  leadershipScore    Float?
  communicationScore Float?
  careerDNA          Json?
  unlockedPersonas   String[]
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt]) // OPTIMIZED: Composite index for user profile updates
}

model InterviewSession {
  id                   String                @id @default(dbgenerated("gen_random_uuid()"))
  userId               String
  persona              String
  currentState         String
  clarityScore         Float?
  confidenceScore      Float?
  ownershipScore       Float?
  specificityScore     Float?
  pressureLevel        Int                   @default(0)
  authenticityScore    Float                 @default(1.0)
  jobTitle             String?
  company              String?
  score                Int?
  status               String                @default("active")
  questions            Json?
  answers              Json?
  analysis             Json?
  startedAt            DateTime              @default(now())
  completedAt          DateTime?
  createdAt            DateTime              @default(now())
  careerTrajectoryScore Float?          @map("career_trajectory_score")
  challengeEntryId     String?
  BehaviorEvent        BehaviorEvent[]
  InterviewEvent       InterviewEvent[]
  PublicChallengeEntry PublicChallengeEntry? @relation(fields: [challengeEntryId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status]) // OPTIMIZED: Composite index for user session filtering
  @@index([status, createdAt]) // OPTIMIZED: Composite index for active sessions
}

model AIUsageLog {
  id              String   @id @default(cuid())
  userId          String?
  sessionId       String?
  provider        String
  model           String
  feature         String
  tokensInput     Int
  tokensOutput    Int
  latencyMs       Int
  costUsd         Float
  cacheHit        Boolean  @default(false)
  confidenceScore Float?
  failureType     String?
  createdAt       DateTime @default(now())
  User            User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([userId, feature]) // OPTIMIZED: Composite index for user feature usage
  @@index([userId, createdAt]) // OPTIMIZED: Composite index for user usage history
  @@index([feature, cacheHit]) // OPTIMIZED: Composite index for cache analysis
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider, userId]) // OPTIMIZED: Composite index for provider queries
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  targetId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  User      User     @relation(fields: [adminId], references: [id])

  @@index([action])
  @@index([adminId])
  @@index([adminId, createdAt]) // OPTIMIZED: Composite index for admin activity history
  @@index([action, createdAt]) // OPTIMIZED: Composite index for action tracking
}

model BehaviorEvent {
  id String @id @default(cuid())
  userId           String
  sessionId        String?
  type             String
  subtype          String?
  timestamp        DateTime         @default(now())
  payload          Json
  latencyMs        Int?
  intensityScore   Float?
  entropyScore     Float?
  previousEventId  String?
  nextEventId      String?
  InterviewSession InterviewSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  User             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId, type])
  @@index([userId, timestamp]) // OPTIMIZED: Composite index for user timeline
  @@index([timestamp]) // OPTIMIZED: Index for time-based queries
}

model BehavioralPattern {
  id String @id @default(cuid())
  userId      String
  pattern     String
  frequency   Int      @default(1)
  severity    Float
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // OPTIMIZED: Missing index for userId
  @@index([userId, severity]) // OPTIMIZED: Composite index for user severity filtering
  @@index([pattern, severity]) // OPTIMIZED: Composite index for pattern analysis
}

model CVAnalysis {
  id String @id @default(cuid())
  userId         String
  fileName       String
  originalText   String
  optimizedText  String
  cvData         Json
  atsScoreBefore Int?
  atsScoreAfter  Int?
  improvements   Json?
  keywords       Json?
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt]) // OPTIMIZED: Composite index for user CV history
  @@index([createdAt]) // OPTIMIZED: Index for time-based queries
}

model InterviewEvent {
  id               String           @id @default(cuid())
  sessionId        String
  type             String
  impactScore      Float?
  createdAt        DateTime         @default(now())
  InterviewSession InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId]) // OPTIMIZED: Missing index for sessionId
  @@index([sessionId, createdAt]) // OPTIMIZED: Composite index for session timeline
}

model ProcessedWebhook {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model PreviewAnalysis {
  id               String   @id @default(cuid())
  token            String   @unique
  createdAt        DateTime @default(now())
  expiresAt        DateTime
  ipHash           String
  fingerprint      String
  cvExtract        Json?    @map("cv_extract") @db.JsonB
  jobExtract       Json?    @map("job_extract") @db.JsonB
  analysisResult   Json?    @map("analysis_result") @db.JsonB
  atsScore         Int?     @map("ats_score") @db.Integer
  strengths        Json?    @map("strengths") @db.JsonB
  weaknesses       Json?    @map("weaknesses") @db.JsonB
  recommendations  Json?    @map("recommendations") @db.JsonB
  rawPayload       Json?    @map("raw_payload") @db.JsonB
  status           String   @default("pending")
  consumed         Boolean  @default(false)
  consumedAt       DateTime? @map("consumed_at")
  claimedByUserId  String?  @map("claimed_by_user_id")
  claimedAt        DateTime? @map("claimed_at")

  @@index([token])
  @@index([expiresAt])
  @@index([consumed])
  @@index([claimedByUserId])
  @@index([claimedByUserId, consumed])
  @@index([status, expiresAt]) // OPTIMIZED: Composite index for cleanup queries
}

model PromptVersion {
  id        String   @id @default(cuid())
  type      String
  version   String
  content   String
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([type, active]) // OPTIMIZED: Composite index for active prompts
}

model PublicChallenge {
  id                   String                 @id @default(cuid())
  slug                 String                 @unique
  name                 String
  description          String
  type                 String
  startDate            DateTime
  endDate              DateTime
  isActive             Boolean                @default(true)
  config               Json
  rewardCredits        Int                    @default(0)
  rewardBadgeId        String?
  PublicChallengeEntry PublicChallengeEntry[]

  @@index([isActive]) // OPTIMIZED: Index for active challenges
  @@index([startDate, endDate]) // OPTIMIZED: Composite index for date range queries
}

model PublicChallengeEntry {
  id               String             @id @default(cuid())
  challengeId      String
  userId           String
  bestScore        Int                @default(0)
  maxPressure      Int                @default(0)
  interruptions    Int                @default(0)
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  InterviewSession InterviewSession[]
  PublicChallenge  PublicChallenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  User             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId]) // OPTIMIZED: Missing index for userId
  @@index([challengeId, bestScore]) // OPTIMIZED: Composite index for leaderboard
}

model RecoveryEmailLog {
  id        String   @id @default(cuid())
  userId    String
  riskLevel String
  cause     String
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([riskLevel, sentAt]) // OPTIMIZED: Composite index for risk monitoring
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires]) // OPTIMIZED: Index for session cleanup
}

model Subscription {
  id               String   @id @default(cuid())
  userId           String   @unique
  stripeCustomerId String
  stripeSubId      String   @unique
  status           String
  currentPeriodEnd DateTime
  plan             Plan     @default(FREE)
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  User             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status]) // OPTIMIZED: Index for subscription status queries
  @@index([currentPeriodEnd]) // OPTIMIZED: Index for renewal queries
}

model UserAnalytics {
  id              String    @id @default(cuid())
  userId          String    @unique
  activationScore Int       @default(0)
  churnRisk       Float     @default(0)
  viralityScore   Float     @default(0)
  engagementScore Float     @default(0)
  lastActiveAt    DateTime?
  updatedAt       DateTime
  User            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([churnRisk]) // OPTIMIZED: Index for churn analysis
  @@index([engagementScore]) // OPTIMIZED: Index for engagement analysis
}

model UserBehaviorProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  pressureType        String?
  weaknessPattern     String?
  targetArchetype     String?
  returnProbability   Float?
  returnSegment       String?
  lastPredictionDate  DateTime?
  onboardingCompleted Boolean   @default(false)
  createdAt           DateTime  @default(now())
  User                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([returnSegment]) // OPTIMIZED: Index for segmentation
  @@index([pressureType]) // OPTIMIZED: Index for pressure type analysis
}

model UserPredictionSnapshot {
  id                String   @id @default(cuid())
  userId            String
  sessionId         String
  returnProbability Float
  returnSegment     String
  primaryDriver     String
  stressScore       Float?
  recoveryScore     Float?
  engagementScore   Float?
  createdAt         DateTime @default(now())
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([returnSegment])
  @@index([userId])
  @@index([userId, createdAt]) // OPTIMIZED: Composite index for user prediction history
}

model WaitlistEntry {
  id               String   @id @default(cuid())
  email            String   @unique
  userId           String?  @unique
  source           String?
  createdAt        DateTime @default(now())
  converted        Boolean  @default(false)
  pressureType     String?
  weakness         String?
  intentReason     String?
  isWillingToRetry Boolean  @default(false)
  status           String   @default("PENDING")
  User             User?    @relation(fields: [userId], references: [id])

  @@index([status]) // OPTIMIZED: Index for status filtering
  @@index([converted]) // OPTIMIZED: Index for conversion tracking
}

enum UserRole {
  USER
  ADMIN_SUPPORT
  ADMIN_PRODUCT
  ADMIN_FOUNDER
}

enum Plan {
  FREE
  PRO
  EXPERT
}

model PremiumInterviewSession {
  id             String   @id @default(uuid())
  userId         String?
  analysisId     String?
  interviewType  String   @default("standard")
  status         String   @default("active")
  score          Int      @default(0)

  questions      Json?
  answers        Json?
  feedback       Json?

  startedAt      DateTime @default(now())
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  careerTrajectoryScore Float?

  @@map("premium_interview_sessions")
  @@index([userId]) // OPTIMIZED: Missing index for userId
  @@index([status]) // OPTIMIZED: Index for status filtering
}

model SimulationSession {
  id         String   @id @default(cuid())
  userId     String?
  createdAt  DateTime @default(now())
  overall    Int
  percentile Int
  scores     Json
  level      String

  @@index([userId]) // OPTIMIZED: Missing index for userId
  @@index([createdAt]) // OPTIMIZED: Index for time-based queries
}

// ============================================================
// SUPABASE TABLES (Billing & Idempotency)
// ============================================================

model CreditTransaction {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey String  @unique @map("idempotency_key") @db.Text
  userId         String  @map("user_id") @db.Text
  amount         Int     @db.Integer
  action         String  @db.Text
  state          tx_state @default(reserved)
  tokensUsed     Int     @default(0) @map("tokens_used") @db.Integer
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("credit_transactions")
  @@index([userId]) // OPTIMIZED: Missing index for userId
  @@index([state]) // OPTIMIZED: Index for state filtering
}

model CreditUsage {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  action            String  @db.Text
  creditsSpent      Int     @map("credits_spent") @db.Integer
  tokensUsed        Int     @default(0) @map("tokens_used") @db.Integer
  estimatedCostEur  Decimal @default(0) @map("estimated_cost_eur") @db.Decimal(10, 6)
  metadata          Json?   @default("{}") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("credit_usage")
  @@index([userId]) // OPTIMIZED: Missing index for userId
  @@index([createdAt]) // OPTIMIZED: Missing index for createdAt
  @@index([userId, createdAt]) // OPTIMIZED: Composite index for user usage history
}

model StripeEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String   @unique @map("event_id") @db.Text
  userId       String?  @map("user_id") @db.Uuid
  creditsAdded Int?     @map("credits_added") @db.Integer
  processedAt  DateTime @default(now()) @map("processed_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("stripe_events")
  @@index([userId]) // OPTIMIZED: Missing index for userId
  @@index([processedAt]) // OPTIMIZED: Index for processing queries
}

model Idempotency {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.Text
  userId         String   @map("user_id") @db.Text
  operation      String   @db.Text
  requestParams  Json     @map("request_params") @db.JsonB
  resultRef      String?  @map("result_ref") @db.Text
  status         String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  expiresAt      DateTime @map("expires_at") @db.Timestamptz

  @@unique([idempotencyKey, userId, operation], name: "idempotency_key_user_op_unique")
  @@index([expiresAt], map: "idx_idempotency_expires_at")
  @@index([status]) // OPTIMIZED: Index for status filtering
  @@map("idempotency")
}

enum tx_state {
  reserved
  committed
  failed
  expired
}

model CvRewrite {
  id               String                                                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                                                   @map("user_id") @db.Text
  idempotencyKey   String                                                   @unique @map("idempotency_key") @db.Text
  action           String                                                   @db.Text
  originalContent  String                                                   @map("original_content") @db.Text
  rewrittenContent String                                                   @map("rewritten_content") @db.Text
  createdAt        DateTime                                                 @default(now()) @map("created_at") @db.Timestamptz
  expiresAt        DateTime                                                 @map("expires_at") @db.Timestamptz

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, expiresAt]) // OPTIMIZED: Composite index for user cleanup
  @@map("cv_rewrites")
}

// ============================================================
// KNOWLEDGE GRAPH PERSISTENCE
// ============================================================

model Graph {
  id          String       @id @default(cuid())
  name        String
  description String?
  version     Int          @default(1)
  isActive    Boolean      @default(true)
  source      String       @default("MANUAL")
  metadata    Json?        @default("{}")
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  
  nodes       GraphNode[]
  edges       GraphEdge[]
  versions    GraphVersion[]
  snapshots   GraphSnapshot[]

  @@index([isActive])
  @@index([deletedAt])
  @@index([source])
  @@index([createdAt])
  @@index([isActive, source]) // OPTIMIZED: Composite index for active graphs by source
  @@map("graphs")
}

model GraphNode {
  id             String       @id @default(cuid())
  graphId        String       @map("graph_id")
  nodeId         String       @map("node_id")
  type           String
  label          String
  normalizedLabel String      @map("normalized_label")
  confidence     Float        @default(0.5)
  source         String
  metadata       Json?        @default("{}")
  embedding      Unsupported("vector(1536)")?
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  
  graph          Graph        @relation(fields: [graphId], references: [id], onDelete: Cascade)
  outgoingEdges  GraphEdge[]  @relation("OutgoingEdges")
  incomingEdges  GraphEdge[]  @relation("IncomingEdges")

  @@index([graphId])
  @@index([type])
  @@index([normalizedLabel])
  @@index([confidence])
  @@index([deletedAt])
  @@index([graphId, type])
  @@index([graphId, normalizedLabel])
  @@index([graphId, type, confidence]) // OPTIMIZED: Composite index for graph queries
  @@index([graphId, deletedAt]) // OPTIMIZED: Composite index for active nodes
  @@map("graph_nodes")
}

model GraphEdge {
  id          String       @id @default(cuid())
  graphId     String       @map("graph_id")
  edgeId      String       @map("edge_id")
  type        String
  sourceNodeId String      @map("source_node_id")
  targetNodeId String      @map("target_node_id")
  weight      Float        @default(0.5)
  confidence   Float        @default(0.5)
  reason      String?
  metadata    Json?        @default("{}")
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  
  graph       Graph        @relation(fields: [graphId], references: [id], onDelete: Cascade)
  sourceNode  GraphNode    @relation("OutgoingEdges", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode  GraphNode    @relation("IncomingEdges", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([graphId])
  @@index([type])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([weight])
  @@index([confidence])
  @@index([deletedAt])
  @@index([graphId, type])
  @@index([graphId, sourceNodeId])
  @@index([graphId, targetNodeId])
  @@index([sourceNodeId, targetNodeId])
  @@index([graphId, type, weight]) // OPTIMIZED: Composite index for edge queries
  @@index([graphId, deletedAt]) // OPTIMIZED: Composite index for active edges
  @@map("graph_edges")
}

model GraphVersion {
  id          String   @id @default(cuid())
  graphId     String   @map("graph_id")
  version     Int
  description String?
  changeLog   Json?    @default("{}")
  nodeCount   Int      @default(0) @map("node_count")
  edgeCount   Int      @default(0) @map("edge_count")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  
  graph       Graph    @relation(fields: [graphId], references: [id], onDelete: Cascade)

  @@unique([graphId, version])
  @@index([graphId])
  @@index([version])
  @@index([createdAt])
  @@index([graphId, version]) // OPTIMIZED: Composite index for version lookup
  @@map("graph_versions")
}

model GraphSnapshot {
  id          String   @id @default(cuid())
  graphId     String   @map("graph_id")
  version     Int
  name        String
  description String?
  nodeData    Json     @map("node_data")
  edgeData    Json     @map("edge_data")
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  
  graph       Graph    @relation(fields: [graphId], references: [id], onDelete: Cascade)

  @@index([graphId])
  @@index([version])
  @@index([createdAt])
  @@index([graphId, version]) // OPTIMIZED: Composite index for snapshot lookup
  @@map("graph_snapshots")
}

// ============================================================
// DATA LINEAGE
// ============================================================

model DataLineage {
  uuid                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceType                   String   @map("source_type") @db.Text
  sourceOrigin                 String   @map("source_origin") @db.Text
  sourceProvenance             String   @map("source_provenance") @db.Text
  sourcePipeline               String   @map("source_pipeline") @db.Text
  sourceStage                  String   @map("source_stage") @db.Text
  parentUuid                   String?  @map("parent_uuid") @db.Uuid
  version                      Int      @default(1)
  timestamp                    DateTime @default(now()) @db.Timestamptz
  confidence                   Float    @default(0.5)
  transformationType           String   @map("transformation_type") @db.Text
  transformationOperation      String   @map("transformation_operation") @db.Text
  transformationInputUuids     Json?    @default("[]") @map("transformation_input_uuids") @db.JsonB
  transformationOutputUuids    Json?    @default("[]") @map("transformation_output_uuids") @db.JsonB
  transformationParameters     Json?    @default("{}") @map("transformation_parameters") @db.JsonB
  transformationDescription     String   @map("transformation_description") @db.Text
  hash                         String   @db.Text
  graphNodeId                  String?  @map("graph_node_id") @db.Uuid
  relationType                 String?  @map("relation_type") @db.Text
  relationTargetUuid           String?  @map("relation_target_uuid") @db.Uuid
  relationName                 String?  @map("relation_name") @db.Text
  relationWeight               Float?   @map("relation_weight")
  relationMetadata             Json?    @default("{}") @map("relation_metadata") @db.JsonB
  storageType                  String   @map("storage_type") @db.Text
  storageLocation              String   @map("storage_location") @db.Text
  storageFormat                String   @map("storage_format") @db.Text
  storageSize                  Int?     @map("storage_size")
  storageCompressed            Boolean  @default(false) @map("storage_compressed")
  storageEncrypted             Boolean  @default(false) @map("storage_encrypted")
  storageRetention             String   @default("PERMANENT") @map("storage_retention") @db.Text
  metadata                     Json?    @default("{}") @db.JsonB
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([parentUuid])
  @@index([sourceType])
  @@index([transformationType])
  @@index([relationType])
  @@index([storageType])
  @@index([graphNodeId])
  @@index([timestamp])
  @@index([confidence])
  @@index([hash]) // OPTIMIZED: Index for deduplication
  @@index([parentUuid, timestamp]) // OPTIMIZED: Composite index for lineage queries
  @@index([graphNodeId, timestamp]) // OPTIMIZED: Composite index for node lineage
  @@map("data_lineage")
}
