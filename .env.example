# ===== Supabase =====
# L'URL de votre projet Supabase (ex: https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://votre-projet.supabase.co"
SUPABASE_URL="https://votre-projet.supabase.co"

# La clé publique anonyme (pour le client web)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJh..."
SUPABASE_ANON_KEY="eyJh..."

# La clé privée Service Role (POUR LE BACKEND UNIQUEMENT, NE JAMAIS EXPOSER)
SUPABASE_SERVICE_ROLE_KEY="eyJh..."

# ===== Database (Prisma) =====
# Utilisé pour les requêtes via le Pooler (port 6543)
DATABASE_URL="postgresql://postgres.votre_id:votre_mot_de_passe@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Connexion directe pour les migrations (port 5432)
DIRECT_URL="postgresql://postgres.votre_id:votre_mot_de_passe@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ===== Upstash Redis =====
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# ===== LLM (OpenAI, Mistral) =====
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4"
MISTRAL_API_KEY="..."

# ===== STT / TTS (Voix) =====
DEEPGRAM_API_KEY="..."
ELEVENLABS_API_KEY="..."
ELEVENLABS_VOICE_ID="..."

# ===== Stripe =====
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ===== Monitoring & Analytics =====
NEXT_PUBLIC_POSTHOG_KEY="..."
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
SENTRY_DSN="https://..."
NEXT_PUBLIC_SENTRY_DSN="https://..."

# ===== App URLs =====
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_GATEWAY_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
NEXT_PUBLIC_VOICE_WS_URL="ws://localhost:3001/api/voice"

# ===== Config Locale =====
LOG_LEVEL="debug"
NODE_ENV="development"

# Browser origins accepted by API and realtime gateway.
# Required in production. Use comma-separated deployed http(s) origins.
ALLOWED_ORIGINS="http://localhost:3000"

# API Redis. Required by API production runtime.
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# Realtime frontend URL. Required in production.
FRONTEND_URL="http://localhost:3000"

# ===== Security Test Environment =====
# Real JWT tokens for runtime security testing (SECURITY-FIX-004.5)
# These must be obtained via real authentication through the application
# DO NOT commit real values to Git
TEST_USER_A_TOKEN=
TEST_USER_B_TOKEN=
TEST_USER_A_ID=
TEST_USER_B_ID=
