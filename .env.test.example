# ============================================
# ENVIRONNEMENT DE TEST E2E (PLAYWRIGHT)
# ============================================
#
# Ce fichier documente toutes les variables d'environnement requises
# pour exécuter les tests E2E avec Playwright.
#
# Pour utiliser :
# 1. Copier ce fichier en .env.test
# 2. Remplir les valeurs avec vos clés de test
# 3. Les tests Playwright chargeront automatiquement .env.test
#
# IMPORTANT : Utilisez des clés de TEST uniquement, jamais de production
# ============================================

# ── Mode d'exécution ─────────────────────────────────────────────────────
NODE_ENV=test
PORT=3000

# ── Supabase (Projet de test dédié) ───────────────────────────────────────
# Créez un projet Supabase dédié aux tests dans le dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-test-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key

# ── Application URL ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── PostHog (Analytics - optionnel pour tests) ─────────────────────────────
# Option 1: Clé de test PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_test_your_posthog_test_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Option 2: Désactiver PostHog pour les tests
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_ENABLED=false

# ── Stripe (Mode Test) ────────────────────────────────────────────────────
# Utilisez les clés de test depuis le dashboard Stripe (mode test activé)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret

# Price IDs (Mode Test)
STRIPE_PRICE_ESSENTIEL=price_test_essentiel
STRIPE_PRICE_PERFORMANCE=price_test_performance
STRIPE_PRICE_STRATEGIQUE=price_test_strategique
STRIPE_PRO_MONTHLY_PRICE_ID=price_test_pro_monthly
STRIPE_PRO_YEARLY_PRICE_ID=price_test_pro_yearly
STRIPE_EXPERT_MONTHLY_PRICE_ID=price_test_expert_monthly
STRIPE_EXPERT_YEARLY_PRICE_ID=price_test_expert_yearly

# ── LLM API Keys (Mode Test) ───────────────────────────────────────────────
# Utilisez des clés de test ou des clés avec quotas limités
OPENAI_API_KEY=sk_test_your_openai_test_key
MISTRAL_API_KEY=your_mistral_test_key
GROQ_API_KEY=gsk_test_your_groq_test_key

# ── Email (Resend - Mode Test) ────────────────────────────────────────────
RESEND_API_KEY=re_test_your_resend_test_key

# ── Cache (Upstash Redis - Optionnel pour tests) ──────────────────────────
# Optionnel : peut être désactivé pour les tests
UPSTASH_REDIS_REST_URL=https://your-test-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_test_redis_token

# ── Sentry (Optionnel pour tests) ──────────────────────────────────────────
# Désactiver Sentry pour les tests pour éviter le bruit
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENV=test

# ── Feature Flags (Tests) ─────────────────────────────────────────────────
USE_PRISMA_PROMPTS=false
USE_PRISMA_AUDIT=false
USE_PRISMA_AI_USAGE=false

# ── Voice (Optionnel pour tests E2E) ───────────────────────────────────────
# ELEVENLABS_API_KEY=your_test_elevenlabs_key
# ELEVENLABS_VOICE_ID=your_test_voice_id
# VOICE_DEBUG=false

# ── Gateway / API URLs (Optionnel) ────────────────────────────────────────
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:3001

# ── Security (Optionnel pour tests) ───────────────────────────────────────
# IPQS_KEY=your_ipqs_test_key
# ABSTRACT_KEY=your_abstract_test_key

# ── Cron / Jobs (Optionnel pour tests) ────────────────────────────────────
# CRON_SECRET=your_test_cron_secret

# ── Queue (Upstash QStash - Optionnel) ───────────────────────────────────
# QSTASH_URL=https://your-test-qstash.upstash.io
# QSTASH_TOKEN=your_test_qstash_token

# ── WebRTC TURN Server (Optionnel pour tests vocaux) ─────────────────────
# TURN_URL=turn:your-turn-server.com:3478

# ── Database (Optionnel - Prisma parallel) ────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/test_db

# ── LLM Models (Optionnel - surcharge) ────────────────────────────────────
# OPENAI_MODEL=gpt-4o-mini
# MISTRAL_MODEL=mistral-small-latest
