# .gitignore — StudioEntretien

# ─── Dépendances ─────────────────────────────────────────────
node_modules/
.pnpm-store/

# ─── Environnement — NE JAMAIS commiter ──────────────────────
.env
.env.local
.env.*.local
.env.production
.env.*

# ─── Next.js ─────────────────────────────────────────────────
.next/
out/
build/
dist/

# ─── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ─── Vercel ──────────────────────────────────────────────────
.vercel

# ─── TypeScript ──────────────────────────────────────────────
*.tsbuildinfo
node_modules/.cache/tsbuildinfo/
next-env.d.ts

# ─── Caches & outils ─────────────────────────────────────────
.cache/
.eslintcache
.turbo/

# ─── Tests / couverture ──────────────────────────────────────
coverage/
.nyc_output/
test-results/
tests/playwright-report/
playwright-report/

# ─── Artefacts générés (traces, rapports lint, benchmarks) ───
artifacts/
*.bundle
eslint-report.json
lint-results.json
lint_output.json
raw-lint.json
lint-final.txt
errors.json
runtime-benchmark.json
runtime-normal-summary.json

# ─── Outils jetables / scratch ───────────────────────────────
scratch/
audit_tools/
eslint_tools/

# ─── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE ─────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ─── Uploads temporaires (sécurité) ──────────────────────────
/tmp/
/uploads/
**/dist/
